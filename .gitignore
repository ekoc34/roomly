# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + nested for moved Next.js project)
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage

# next.js (root + nested at /app/frontend/.next)
/.next/
**/.next/
/out/
**/out/

# production
/build
**/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env
-e 
